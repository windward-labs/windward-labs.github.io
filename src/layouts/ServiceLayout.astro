---
import BaseLayout from './BaseLayout.astro';
import '../styles/service.css';
interface Props { title: string }
const { title } = Astro.props;
---
<BaseLayout title={`${title} — Windward Labs`}>
  <meta slot="head" name="robots" content="noindex, nofollow" />
  <div class="workspace">
    <aside class="masthead" aria-label="Service navigation">
      <a href="/" class="wordmark">Windward Labs</a>
      <nav class="service-navigation" aria-label="Service"><a href="/service/">Dashboard</a></nav>
      <div id="service-session"></div>
    </aside>
    <main class="workspace-content">
      <slot />
      <footer class="workspace-footer"><span>© 2026 Windward Labs, Inc.</span></footer>
    </main>
  </div>
</BaseLayout>
