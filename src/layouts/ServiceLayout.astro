---
import BaseLayout from './BaseLayout.astro';
import '../styles/service.css';
interface Props { title: string }
const { title } = Astro.props;
---
<BaseLayout title={`${title} — Windward Labs`}>
  <main class="workspace">
    <header class="masthead">
      <a href="/" class="wordmark">Windward Labs</a>
      <a href="mailto:hi@windwardlabs.xyz" class="contact">Contact</a>
    </header>
    <slot />
    <footer class="workspace-footer"><span>© 2026 Windward Labs, Inc.</span></footer>
  </main>
</BaseLayout>
