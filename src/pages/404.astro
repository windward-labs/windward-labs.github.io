---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Not Found — Windward Labs">
  <main class="not-found">
    <h1 class="not-found-title">Not Found</h1>
    <a href="/" class="not-found-link">Windward Labs</a>
  </main>
</BaseLayout>

<style>
  .not-found {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    min-height: 100dvh;
    text-align: center;
    padding: 2rem;
  }

  .not-found-title {
    font-family: var(--font-mono);
    font-weight: 400;
    font-size: 10px;
    margin-bottom: 0.75rem;
  }

  .not-found-link {
    font-size: 10px;
  }
</style>
