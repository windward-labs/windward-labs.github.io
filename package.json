{
  "name": "windward-labs-site",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "test": "node --test tests/*.test.mjs",
    "typecheck": "tsc --noEmit",
    "dev:api": "wrangler dev --config backend/wrangler.jsonc",
    "dev:stripe": "node backend/listen-stripe.mjs",
    "db:migrate:local": "wrangler d1 migrations apply windward-service --local --config backend/wrangler.jsonc"
  },
  "dependencies": {
    "@astrojs/mdx": "^4.2.0",
    "@pdf-lib/fontkit": "^1.1.1",
    "@privy-io/node": "^0.35.0",
    "@privy-io/react-auth": "^3.47.0",
    "astro": "^5.4.1",
    "pdf-lib": "^1.17.1",
    "stripe": "^23.0.0"
  },
  "devDependencies": {
    "@stripe/cli": "^1.53.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "agentation": "^3.1.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^5.9.3",
    "wrangler": "^4.147.0"
  }
}
